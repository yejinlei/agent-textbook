    {
      "id": "wrong-advice",
      "title": "Wrong advice",
      "author": "Magabi Eynew Gessesse, Elizabeth Laird",
      "translator": null,
      "illustrator": "Brian Wambi",
      "year": 2016,
      "level": "PB1",
      "primary_topic": "family.pets",
      "secondary_topics": [
        "money",
        "family",
        "poverty"
      ],
      "source": "african-storybook",
      "source_url": "https://www.africanstorybook.org/read.php?id=21795",
      "asb_id": 21795,
      "asb_level": "First words",
      "license": {
        "text": "CC-BY-4.0",
        "image": "CC-BY-4.0",
        "audio_raw": null
      },
      "attribution": "Source: https://www.africanstorybook.org/read.php?id=21795. License: CC-BY-4.0.",
      "tags": [],
      "pages": [
        {
          "n": 1,
          "text": "They wished they had a donkey. He would carry things for them.",
          "image": "images/wrong-advice/p1.png"
        },
        {
          "n": 2,
          "text": "Kombe said, “Let us buy a donkey together.” They were happy.",
          "image": "images/wrong-advice/p2.png"
        },
        {
          "n": 3,
          "text": "When Kombe's father died, Kombe inherited riches. He forgot Juma.",
          "image": "images/wrong-advice/p3.png"
        },
        {
          "n": 4,
          "text": "Kombe wanted donkey meat for his dogs. Juma needed the donkey for work.",
          "image": "images/wrong-advice/p4.png"
        },
        {
          "n": 5,
          "text": "The judge said, “Each of you can take half the donkey.”",
          "image": "images/wrong-advice/p5.png"
        },
        {
          "n": 6,
          "text": "Kombe killed the donkey. Juma carried things for himself once again.",
          "image": "images/wrong-advice/p6.png"
        },
        {
          "n": 7,
          "text": "Kombe wanted to burn his hut and build a new one.",
          "image": "images/wrong-advice/p7.png"
        },
        {
          "n": 8,
          "text": "Juma said, “Mine will burn too.” The judge agreed with Kombe.",
          "image": "images/wrong-advice/p8.png"
        },
        {
          "n": 9,
          "text": "Juma’s hut burned. The judge said, “Kombe burned only his hut.”",
          "image": "images/wrong-advice/p9.png"
        },
        {
          "n": 10,
          "text": "Juma had no donkey, no hut. He slept under the tree.",
          "image": "images/wrong-advice/p10.png"
        },
        {
          "n": 11,
          "text": "Juma worked hard. He had a good crop of peas.",
          "image": "images/wrong-advice/p11.png"
        },
        {
          "n": 12,
          "text": "Kombe’s boys ate most of the peas from Juma’s land.",
          "image": "images/wrong-advice/p12.png"
        },
        {
          "n": 13,
          "text": "The boys said, “Ask our father to pay for your peas.”",
          "image": "images/wrong-advice/p13.png"
        },
        {
          "n": 14,
          "text": "Juma said, “I don’t want your money. I want my peas.”",
          "image": "images/wrong-advice/p14.png"
        },
        {
          "n": 15,
          "text": "The judge told Juma, “Cut the boys open. Take your peas.”",
          "image": "images/wrong-advice/p15.png"
        },
        {
          "n": 16,
          "text": "Juma refused to listen. Kombe cried, “Let the elders decide.”",
          "image": "images/wrong-advice/p16.png"
        },
        {
          "n": 17,
          "text": "The elders told Kombe, \"You killed the donkey. You burned his hut.\"",
          "image": "images/wrong-advice/p17.png"
        },
        {
          "n": 18,
          "text": "They said to Juma, \"Killing Kombe's sons is wrong too.\"",
          "image": "images/wrong-advice/p18.png"
        },
        {
          "n": 19,
          "text": "Kombe gave Juma half of his property. They lived happily.",
          "image": "images/wrong-advice/p19.png"
        }
      ],
