{
  "_doc": "英文长文库多维分类标准（faceted taxonomy），供 catalog.json 与 UI 检索共用",
  "_updated": "2026-10-13",
  "_scope": "小学英语 3-6 年级，与 picturebooks/topics.json 保持兼容",

  "dimensions": {

    "grade": {
      "description": "适配年级（可多档，用数组表达跨年级）",
      "type": "multi_enum",
      "values": ["1", "2", "3", "4", "5", "6", "7", "8"],
      "bands": {
        "early_primary": {"grades": ["1", "2"], "lexile_range": "0-400L"},
        "mid_primary":   {"grades": ["3", "4"], "lexile_range": "300-700L"},
        "late_primary":  {"grades": ["5", "6"], "lexile_range": "700-1000L"},
        "middle_school": {"grades": ["7", "8"], "lexile_range": "900-1200L"}
      }
    },

    "topic": {
      "description": "话题（对齐 picturebooks/topics.json 的 primary_topic 与 secondary_topics）",
      "type": "multi_enum",
      "primary_allowed": [
        "animal", "family.pets", "nature.cosmic", "nature.plants",
        "food", "identity", "narrative.hero", "friendship",
        "job", "money", "poverty", "animal.fable"
      ],
      "primary_note": "与 picturebooks/topics.json 保持 id 一致，便于跨源推荐"
    },

    "text_type": {
      "description": "文本类型（体裁）",
      "type": "single_enum",
      "values": {
        "fable":           "寓言（Aesop 型动物寓言，通常 100-500 词，含寓意）",
        "folktale":        "民间故事（口传/改编，通常有 magic 或动物主角）",
        "fantasy":         "幻想文学（魔法/异世界，Alice、Wizard of Oz 型）",
        "realistic_fiction": "现实主义虚构（现实世界背景，Heidi、Tom Sawyer 型）",
        "adventure":       "冒险文学（情节驱动，Treasure Island、Call of the Wild 型）",
        "detective":       "侦探文学（Sherlock Holmes 型）",
        "satire":          "讽刺/游记（Gulliver 型）",
        "memoir":          "回忆录（暂不用）",
        "essay":           "散文（暂不用）"
      }
    },

    "themes": {
      "description": "情感/价值观主题（可多标签，用于教材活动主题映射）",
      "type": "multi_enum",
      "values": {
        "courage": "勇气",
        "kindness": "善良",
        "honesty": "诚实",
        "friendship": "友谊",
        "perseverance": "坚持",
        "self_acceptance": "自我接纳",
        "belonging": "归属感",
        "growing_up": "成长",
        "imagination": "想象力",
        "justice": "正义",
        "loyalty": "忠诚",
        "resilience": "韧性",
        "survival": "生存",
        "homecoming": "归家",
        "generosity": "慷慨",
        "humility": "谦逊",
        "curiosity": "好奇",
        "love_loss": "爱与失去",
        "disobedience": "违纪/后果",
        "reason": "理性",
        "family": "家庭亲情",
        "trade_sharing": "交易与分享",
        "money_wealth": "金钱财富"
      }
    },

    "setting": {
      "description": "故事背景（地理/环境类型）",
      "type": "multi_enum",
      "values": {
        "countryside": "乡村",
        "rural_village": "村庄",
        "city_urban": "城市",
        "school": "学校",
        "forest_wild": "森林荒野",
        "mountain": "山地",
        "sea_nautical": "海上/航海",
        "jungle": "丛林",
        "arctic": "极地",
        "farm": "农场",
        "garden_park": "花园/公园",
        "magical_world": "奇幻世界",
        "space_outer": "太空/外太空",
        "medieval": "中世纪",
        "nature_outdoor": "自然户外（水、田、草原等非具体环境）"
      }
    },

    "word_count_bucket": {
      "description": "总词数分桶（读完后统计回填）",
      "type": "single_enum",
      "buckets": {
        "very_short": {"min": 0,    "max": 500,   "reading_time_min": [1, 3],   "target_grades": ["3", "4"]},
        "short":      {"min": 500,  "max": 1500,  "reading_time_min": [3, 6],   "target_grades": ["3", "4", "5"]},
        "medium":     {"min": 1500, "max": 3000,  "reading_time_min": [6, 12],  "target_grades": ["4", "5", "6"]},
        "long":       {"min": 3000, "max": 5000,  "reading_time_min": [12, 20], "target_grades": ["5", "6", "7"]},
        "very_long":  {"min": 5000, "max": null,  "reading_time_min": [20, null], "target_grades": ["6", "7", "8"]}
      }
    },

    "lexile": {
      "description": "蓝思难度（用估算区间，官方需 Lexile Studio 认证）",
      "type": "range",
      "bands": {
        "elementary_low":    {"min": 200, "max": 500,  "grade_hint": "3"},
        "elementary_mid":    {"min": 500, "max": 800,  "grade_hint": "3-4"},
        "elementary_high":   {"min": 800, "max": 1000, "grade_hint": "4-5"},
        "middle_early":      {"min": 1000,"max": 1200, "grade_hint": "5-6"},
        "middle_late":       {"min": 1200,"max": 1500, "grade_hint": "6-7"}
      },
      "source_note": "本库数值为编辑估算，基于词汇复杂度 + 平均句长；后续可用 readability 公式重算"
    },

    "cultural_origin": {
      "description": "作者所属文化（用于跨文化主题对齐）",
      "type": "single_enum",
      "values": [
        "British", "American", "Danish", "Greek", "Swiss_German",
        "French", "British_Indian", "British_Scottish", "British_Irish",
        "Canadian", "British_American",
        "Kenyan", "Ethiopian", "Ghanaian", "South_African", "African_Oral", "Other"
      ]
    },

    "time_period": {
      "description": "故事背景时代",
      "type": "single_enum",
      "values": {
        "timeless_fantasy": "无时代背景/奇幻",
        "medieval":         "中世纪（Robin Hood）",
        "18th_century":     "18 世纪（Gulliver, Rip Van Winkle）",
        "victorian":        "维多利亚时代（19 世纪英国）",
        "early_20th":       "20 世纪初（Peter Rabbit, Winnie Pooh, Oz）",
        "modern":           "现代（暂未收录）"
      }
    },

    "target_skill": {
      "description": "适配的教材教学目标（可多标签）",
      "type": "multi_enum",
      "values": {
        "reading_comprehension": "阅读理解",
        "vocabulary_extension":  "词汇拓展",
        "retelling":             "复述故事",
        "grammar_practice":      "语法练习（tense, comparative, there_be）",
        "writing_inspiration":   "写作启发",
        "cultural_awareness":    "文化意识",
        "critical_thinking":     "批判思维"
      }
    },

    "text_role": {
      "kind": "list",
      "type": "extension_role",
      "values": [
        "pre_reading", "bridge_text", "consolidation",
        "extension", "compare_contrast",
        "writing_trigger", "culture_window"
      ],
      "desc": "该文本在教材单元里可承担的挂载角色（多值；由 tools/pair_extensions.py 计算，也可人工标注）",
      "optional": true,
      "_ref": "data/readings/extension_roles.json"
    }

  },

  "facets_on_instance": {
    "description": "每本 Reading 实例上打的分面标签（写入 catalog.json 的 book 对象）",
    "fields": {
      "grade": "array<string> (来自 dimensions.grade.values)",
      "grade_band": "string (early/mid/late_primary 或 middle_school)",
      "text_type": "string (来自 dimensions.text_type.values)",
      "themes": "array<string>",
      "settings": "array<string>",
      "word_count_bucket": "string",
      "lexile": {"min": "int", "max": "int", "mean": "int", "band": "string", "source": "editor_estimate|lexile_studio|readability_formula"},
      "cultural_origin": "string",
      "time_period": "string",
      "target_skills": "array<string>"
    }
  }
}
