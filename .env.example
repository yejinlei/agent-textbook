# agent-textbook 运行环境配置（模板）
#
# 用法：
#   cp .env.example .env      # Windows: copy .env.example .env
#   然后填入 VLM_API_KEY 即可，程序启动时自动加载。
#
# 所有参数都有默认值，只有 VLM_API_KEY 必须填。

# ------------------------------------------------------------------ VLM 多模态提取
# 必填：从商汤开放平台获取
VLM_API_KEY=
VLM_BASE_URL=https://token.sensenova.cn/v1
VLM_MODEL=sensenova-6.8-flash-lite

# 渲染 dpi —— 提取成败的关键，不要随意调高：
#   200 dpi：图片约 1.6MB，模型把 token 全耗在推理上、返回空内容，还会触发 413
#   150 dpi：图片约 937KB，实测稳定成功（推荐，不要改）
VLM_DPI=150

# 页级并发 —— 该接口并发能力很弱，实测：
#   12 并发：平台侧排队，30 秒/页，且大量失败
#    8 并发：约 10 秒/页（整册批量用，速度优先；失败页留给 backfill 补）
#    4 并发：补零散页时仍会大面积 429 / 返回空
#    1 并发：补零散页最稳，实测 2 页/分钟且几乎不失败（backfill 默认值）
# 结论：批量求快用 8，补漏求稳用 1，不要中间值。
VLM_WORKERS=8

# 推理型模型会先用掉上千 token 思考，正文需要留出空间
VLM_MAX_TOKENS=8192
VLM_TIMEOUT=180

# 失败重试：429 是平台侧限流，退避必须够长
VLM_MAX_RETRIES=2
VLM_RETRY_DELAYS=5,20,60

# ------------------------------------------------------------------ 解析通道
PARSE_ENGINE=auto
TEXT_LAYER_MIN_CHARS=50
